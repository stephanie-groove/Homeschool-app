# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (safe to expose to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (never prefix with VITE_)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
COACH_DAILY_LIMIT=60
